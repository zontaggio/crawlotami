    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/node-telegram-bot-api": "^0.64.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
