# --- Required ---------------------------------------------------------------

# Your Prenotami account
PRENOTAMI_EMAIL=your-email@example.com
PRENOTAMI_PASSWORD=your-password

# Telegram: create a bot with @BotFather, then get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789

# --- Optional (defaults shown) ----------------------------------------------

# Minutes between checks. The minimum is 5, to keep the load on Prenotami low.
# CHECK_INTERVAL_MINUTES=10

# Hours between "still running" heartbeat messages.
# HEARTBEAT_HOURS=1

# Row of the service to watch in Prenotami's "Book" table. 1 is usually passports.
# PRENOTAMI_SERVICE_ROW=1

# Set to false to see the browser window, e.g. to solve a CAPTCHA yourself.
# HEADLESS=true

# Time zone and locale for timestamps and the browser.
# TIMEZONE=America/Sao_Paulo
# LOCALE=pt-BR
